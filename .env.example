SPRITE_CAMERA_SNAPSHOT_URL=

MAX_HOTEND_TEMP=300
MAX_BED_TEMP=120
MAX_JOG_MM=50
MAX_EXTRUDE_MM=100
JOG_SPEED=3000
CONTROL_TIMEOUT=5
CAMERA_TIMEOUT=6
FILAMENT_LOW_G=100

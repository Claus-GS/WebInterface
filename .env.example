# Copy this file to .env and fill in real local values.
# Do not commit .env.

DASHBOARD_PASSWORD=change-me-to-a-long-random-password
FLASK_SECRET_KEY=change-me-to-a-long-random-secret

HOST=0.0.0.0
PORT=8100
UPDATE_INTERVAL=2
DASHBOARD_DATA_FILE=dashboard_data.json

MINIMUS_LABEL=Minimus
